{
  "name": "reviewpipe-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pipeline framework for analyzing e-commerce customer reviews",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "data:download": "bash scripts/download-datasets.sh",
    "benchmark": "pnpm --filter ./packages/benchmarks run benchmark"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "eslint": "^9.10.0",
    "@typescript-eslint/parser": "^8.5.0",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "prettier": "^3.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
