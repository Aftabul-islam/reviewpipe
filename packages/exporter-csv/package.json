{
  "name": "@reviewpipe/exporter-csv",
  "version": "0.1.0",
  "description": "CSV exporter for reviewpipe — flattens themes and trend into a tidy CSV table.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*",
    "csv-stringify": "^6.5.2"
  },
  "devDependencies": {
    "@reviewpipe/adapter-csv": "workspace:*",
    "@reviewpipe/provider-lexicon": "workspace:*",
    "csv-parse": "^5.5.6"
  },
  "sideEffects": false,
  "homepage": "https://github.com/Aftabul-islam/reviewpipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftabul-islam/reviewpipe.git",
    "directory": "packages/exporter-csv"
  },
  "bugs": {
    "url": "https://github.com/Aftabul-islam/reviewpipe/issues"
  },
  "keywords": [
    "reviewpipe",
    "reviews",
    "sentiment",
    "sentiment-analysis",
    "nlp",
    "csv",
    "exporter"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
