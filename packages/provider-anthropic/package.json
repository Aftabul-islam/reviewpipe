{
  "name": "@reviewpipe/provider-anthropic",
  "version": "0.1.0",
  "description": "Anthropic (Claude) frontier provider for reviewpipe (Tier 2) — sentiment and summarization via the Anthropic SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^0.68.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "sideEffects": false,
  "homepage": "https://github.com/Aftabul-islam/reviewpipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftabul-islam/reviewpipe.git",
    "directory": "packages/provider-anthropic"
  },
  "bugs": {
    "url": "https://github.com/Aftabul-islam/reviewpipe/issues"
  },
  "keywords": [
    "reviewpipe",
    "reviews",
    "sentiment",
    "sentiment-analysis",
    "nlp",
    "anthropic",
    "claude",
    "llm"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
