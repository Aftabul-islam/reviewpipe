{
  "name": "@reviewpipe/provider-local",
  "version": "0.0.0",
  "description": "Local transformers.js sentiment + embedding provider for reviewpipe (Tier 0). Runs models on-device with no API key.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*"
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.0"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "sideEffects": false
}
