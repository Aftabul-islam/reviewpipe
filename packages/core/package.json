{
  "name": "@reviewpipe/core",
  "version": "0.1.0",
  "description": "Schema, interfaces, and pipeline engine for reviewpipe. Zero ML dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs"
  },
  "sideEffects": false,
  "homepage": "https://github.com/Aftabul-islam/reviewpipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftabul-islam/reviewpipe.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Aftabul-islam/reviewpipe/issues"
  },
  "keywords": [
    "reviewpipe",
    "reviews",
    "sentiment",
    "sentiment-analysis",
    "nlp",
    "pipeline",
    "text-analysis"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
