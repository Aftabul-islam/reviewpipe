{
  "name": "@reviewpipe/provider-local",
  "version": "0.1.0",
  "description": "Local transformers.js sentiment + embedding provider for reviewpipe (Tier 0). Runs models on-device with no API key.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*"
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.0"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    }
  },
  "sideEffects": false,
  "homepage": "https://github.com/Aftabul-islam/reviewpipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftabul-islam/reviewpipe.git",
    "directory": "packages/provider-local"
  },
  "bugs": {
    "url": "https://github.com/Aftabul-islam/reviewpipe/issues"
  },
  "keywords": [
    "reviewpipe",
    "reviews",
    "sentiment",
    "sentiment-analysis",
    "nlp",
    "transformers",
    "transformers.js",
    "embeddings",
    "on-device"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
