{
  "name": "@reviewpipe/exporter-json",
  "version": "0.0.0",
  "description": "JSON exporter for reviewpipe — serializes an AnalysisResult to JSON.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*"
  },
  "devDependencies": {
    "@reviewpipe/adapter-csv": "workspace:*",
    "@reviewpipe/provider-lexicon": "workspace:*"
  },
  "sideEffects": false
}
