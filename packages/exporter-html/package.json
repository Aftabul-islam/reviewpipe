{
  "name": "@reviewpipe/exporter-html",
  "version": "0.1.0",
  "description": "HTML dashboard exporter for reviewpipe — a self-contained report with inline SVG charts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "prepack": "pnpm run build && node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@reviewpipe/core": "workspace:*"
  },
  "devDependencies": {
    "@reviewpipe/adapter-csv": "workspace:*",
    "@reviewpipe/provider-lexicon": "workspace:*"
  },
  "sideEffects": false,
  "homepage": "https://aftabul-islam.github.io/reviewpipe/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aftabul-islam/reviewpipe.git",
    "directory": "packages/exporter-html"
  },
  "bugs": {
    "url": "https://github.com/Aftabul-islam/reviewpipe/issues"
  },
  "keywords": [
    "reviewpipe",
    "reviews",
    "sentiment",
    "sentiment-analysis",
    "nlp",
    "html",
    "dashboard",
    "exporter"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
