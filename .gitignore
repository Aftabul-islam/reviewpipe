# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Env / secrets
.env
.env.local
.env.*.local

# Local-only working docs and AI tooling — kept on disk, not in git
docs/DEV_GUIDE.md
CLAUDE.md
.claude/

# Real downloaded datasets — regenerate via scripts/download-datasets.sh
data/raw/

# Benchmark output — local only, regenerate via `pnpm benchmark`
BENCHMARKS.md

# LICENSE/NOTICE copied into each package at publish time (prepack), not committed
packages/*/LICENSE
packages/*/NOTICE

# Example script output
examples/*/out/

# Editor / OS
.vscode/
.idea/
.DS_Store

# Test/coverage artifacts
coverage/
.vitest/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
