  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@reviewpipe/core": ["packages/core/src/index.ts"],
      "@reviewpipe/provider-lexicon": ["packages/provider-lexicon/src/index.ts"],
      "@reviewpipe/provider-local": ["packages/provider-local/src/index.ts"],
      "@reviewpipe/adapter-csv": ["packages/adapter-csv/src/index.ts"],
      "@reviewpipe/adapter-json": ["packages/adapter-json/src/index.ts"],
